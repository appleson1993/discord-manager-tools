{
  "name": "discord-server-manager",
  "version": "1.0.0",
  "description": "Discord 視覺化頻道管理助手",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "vite build && electron-builder",
    "start": "npm run electron:dev"
  },
  "keywords": [
    "electron",
    "discord",
    "vue"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "discord.js": "^14.14.0",
    "dotenv": "^16.3.0",
    "sass": "^1.97.1",
    "sortablejs": "^1.15.0",
    "vite-plugin-vuetify": "^2.1.2",
    "vue": "^3.4.0",
    "vuetify": "^3.11.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "concurrently": "^8.0.0",
    "electron": "latest",
    "electron-builder": "^24.0.0",
    "vite": "^8.3.5",
    "wait-on": "^7.0.0"
  }
}
